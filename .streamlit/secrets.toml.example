# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → App → Settings → Secrets.
# NEVER commit the real secrets.toml to git.

# Only these Google accounts may sign in (lower-case). Leave empty [] to allow any Google account.
allowed_emails = ["you@gmail.com"]

[database]
# Supabase → Project → Connect → "Session pooler" (IPv4-compatible) connection string.
# Replace [YOUR-PASSWORD]. Keep the postgresql+psycopg2:// prefix.
url = "postgresql+psycopg2://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

[auth]
# Must match an "Authorised redirect URI" in your Google OAuth client.
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
